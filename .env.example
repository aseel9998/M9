# Copy to .env (never commit it). All variables are optional.
PORT=3000
HOST=0.0.0.0
BK_DATA_DIR=./data
PANEL_PATH=knight
# Recommended: require this key on first-run setup so strangers cannot claim the panel.
SETUP_KEY=
# Optional: initial password (min 8 chars), applied only when no password exists yet.
PANEL_PASSWORD=
LOG_LEVEL=INFO
LOG_MAX_MB=5
LOG_MAX_FILES=5
LOG_RETENTION_DAYS=14
LOG_STDOUT=true
# Set false to write "[masked]" instead of client IPs in logs.
LOG_CLIENT_IP=true
# Number of reverse proxies in front of the app (PaaS = 1). 0 = connect directly.
TRUST_PROXY_HOPS=0
COOKIE_SECURE=auto
